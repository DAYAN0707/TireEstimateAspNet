@page
@model IndexModel
@{
    ViewData["Title"] = "タイヤ見積もり";
}

<h1>タイヤ見積アプリ.NET版</h1>
<p>C#勉強！</p>

<hr />

<!-- 見積もりの入力フォーム -->
<form method="post">
    <div style="margin-bottom: 10px;">
        <label>タイヤの価格: </label><br />
        <input type="number" asp-for="UnitPrice" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>本数:</label><br />
        <input type="number" asp-for="Quantity" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>お客様名:</label><br />
        <input type="text" asp-for="CustomerName" />
    </div>

    <div style="margin-bottom: 10px;">
        <label>タイヤサイズ:</label><br />
        <input type="text" asp-for="TireSize" />
    </div>

    <button type="submit" class="btn btn-primary" style="margin-top: 10px;">見積を計算する</button>
</form>

<!-- 計算ボタンが押された時だけ結果表示 -->
@if (Model.IsCalculated)
{
    <hr />
    <h2>見積結果</h2>
    <p>単価: @Model.UnitPrice.ToString("#,##0") 円</p>
    <p>本数: @Model.Quantity 本</p>
    <h3>合計金額: @Model.TotalAmount.ToString("#,##0") 円</h3>
}


<hr class="my-4" />

<h2>保存済み見積もり一覧</h2>

<table class="table table-striped table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>見積ID</th>
            <th>お客様名</th>
            <th>タイヤサイズ</th>
            <th>単価</th>
            <th>本数</th>
            <th>合計金額</th>
            <th>作成日時</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quote in Model.QuoteList)
        {
            <tr>
                <td>@quote.Id</td>
                <td>@quote.CustomerName</td>
                <td>@quote.TireSize</td>
                <td>@quote.UnitPrice.ToString("#,##0") 円</td>
                <td>@quote.Quantity 本</td>
                <td>@quote.TotalAmount.ToString("#,##0") 円</td>
                <td>@quote.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
            </tr>
        }
    </tbody>  
</table>