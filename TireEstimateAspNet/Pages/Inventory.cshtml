@page
@model TireEstimateAspNet.Pages.InventoryModel
@{
    ViewData["Title"] = "タイヤ在庫一覧";
}

<h1>タイヤ在庫一覧</h1>

<hr />

<!-- 💡 タイヤ在庫登録フォーム -->
<h2>タイヤ在庫登録</h2>

<form method="post" class="mb-5">
    <div class="mb-3">
        <label class="form-label">タイヤサイズ</label>
        <input asp-for="NewInventory.TireSize" class="form-control" placeholder="例: 195/65R15" required />
    </div>

    <div class="mb-3">
        <label class="form-label">種類</label>
        <input asp-for="NewInventory.Season" class="form-control" placeholder="例: 夏" required />
    </div>

    <div class="mb-3">
        <label class="form-label">在庫本数</label>
        <input asp-for="NewInventory.StockQuantity" class="form-control" type="number" min="0" required />
    </div>

    <div class="mb-3">
        <label class="form-label">単価</label>
        <input asp-for="NewInventory.UnitPrice" class="form-control" type="number" min="0" required />
    </div>

    <button type="submit" class="btn btn-primary">在庫を登録</button>
</form>

<hr class="my-4"/>

<!-- 在庫検索フォーム -->
<h2>在庫検索</h2>

<form method="get" class="mb-4">
    <div class="input-group">
        <input asp-for="SearchTireSize" class="form-control" placeholder="例: 195/65R15" />
  \     
        <button type="submit" class="btn btn-secondary">検索</button>

        <a asp-page="./Inventory" class="btn btn-secondary">クリア</a>
    </div>
</form>

<!-- 在庫一覧テーブル -->
<h2>在庫一覧</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>在庫ID</th>
            <th>タイヤサイズ</th>
            <th>種類</th>
            <th>在庫本数</th>
            <th>単価</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tire in Model.InventoryList)
        {
            <tr>
                <td>@tire.Id</td>
                <td>@tire.TireSize</td>
                <td>@tire.Season</td>
                <td>@tire.StockQuantity 本</td>
                <td>@tire.UnitPrice.ToString("#,##0") 円</td>
                <!-- 編集ボタン追加（asp-route-id で在庫IDをパラメータ渡し）-->
                <!-- ここで InventoryEdit ページへのリンクを作成 -->
                <!--asp-route-idはリンク先のページに ID を引き渡すための ASP.NET Core の仕組み（Tag Helper）-->
                <a asp-page="./InventoryEdit" asp-route-id="@tire.Id" class="btn btn-sm btn-warning">編集</a>
            </tr>
        }
    </tbody>
</table>